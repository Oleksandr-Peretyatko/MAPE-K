    "POSTGRES_DB": "versiondb",
    "POSTGRES_PASSWORD": "postgres",
    "POSTGRES_USER": "postgres"
   },
   "healthcheck": {
    "interval": "10s",
    "retries": 5,
    "test": [
     "CMD-SHELL",
     "pg_isready -U postgres"
    ],
    "timeout": "5s"
   },
   "image": "postgres:14-alpine"
  },
  "version-service": {
   "container_name": "version-service",
   "depends_on": {
    "eureka-server": {
     "condition": "service_healthy",
     "required": true
    },
    "jaeger": {
     "condition": "service_started",
     "required": true
    },
    "rabbitmq": {
     "condition": "service_healthy",
     "required": true
    },
    "version-db": {
     "condition": "service_healthy",
     "required": true
    }
   },
   "environment": {
    "EUREKA_HOST": "eureka-server",
    "JAVA_TOOL_OPTIONS": "-XX:InitialRAMPercentage=50.0 -XX:MaxRAMPercentage=75.0",
    "SPRING_DATASOURCE_URL": "jdbc:postgresql://version-db:5432/versiondb",
    "SPRING_PROFILES_ACTIVE": "version-service,stream",
    "SPRING_RABBITMQ_HOST": "rabbitmq",
    "START_CLASS": "org.anonymous.msrefactor.ms.versioning.VersionServiceApplication"
   },
   "healthcheck": {
    "interval": "30s",
    "retries": 5,
    "start_period": "3m0s",
    "test": [
     "CMD-SHELL",
     "wget -q --spider http://localhost:8081/actuator/health || exit 1"
    ],
    "timeout": "10s"
   },
   "image": "simulator:latest",
   "ports": [
    {
     "mode": "ingress",
     "protocol": "tcp",
     "published": "8081",
     "target": 8081
    }
   ]
  }
 }
}