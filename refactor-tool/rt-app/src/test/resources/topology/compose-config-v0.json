{
 "name": "microservices-simulator",
 "services": {
  "answer-db": {
   "container_name": "answer-db",
   "environment": {
    "POSTGRES_DB": "answerdb",
    "POSTGRES_PASSWORD": "postgres",
    "POSTGRES_USER": "postgres"
   },
   "healthcheck": {
    "interval": "10s",
    "retries": 5,
    "test": [
     "CMD-SHELL",
     "pg_isready -U postgres"
    ],
    "timeout": "5s"
   },
   "image": "postgres:14-alpine"
  },
  "answer-service": {
   "container_name": "answer-service",
   "depends_on": {
    "answer-db": {
     "condition": "service_healthy",
     "required": true
    },
    "eureka-server": {
     "condition": "service_healthy",
     "required": true
    },
    "jaeger": {
     "condition": "service_started",
     "required": true
    },
    "rabbitmq": {
     "condition": "service_healthy",
     "required": true
    }
   },
   "environment": {
    "EUREKA_HOST": "eureka-server",
    "JAVA_TOOL_OPTIONS": "-XX:InitialRAMPercentage=50.0 -XX:MaxRAMPercentage=75.0",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4317",
    "SPRING_DATASOURCE_URL": "jdbc:postgresql://answer-db:5432/answerdb",
    "SPRING_PROFILES_ACTIVE": "answer-service,sagas,stream",
    "SPRING_PROFILES_INCLUDE": "",
    "SPRING_RABBITMQ_HOST": "rabbitmq",
    "START_CLASS": "org.anonymous.msrefactor.quizzes.microservices.answer.AnswerServiceApplication"
   },
   "healthcheck": {
    "interval": "30s",
    "retries": 5,
    "start_period": "3m0s",
    "test": [
     "CMD-SHELL",
     "wget -q --spider http://localhost:8082/actuator/health || exit 1"
    ],
    "timeout": "10s"
   },
   "image": "quizzes:latest",
   "ports": [
    {
     "mode": "ingress",
     "protocol": "tcp",
     "published": "8082",
     "target": 8082
    }
   ]
  },
  "course-db": {
   "container_name": "course-db",
